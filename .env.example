# Copie para .env e preencha. O arquivo .env NUNCA deve ser versionado.

# Chave da API do Portal da Transparência (CEIS/CNEP).
# Cadastro gratuito: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA=

# Chave da API DeepSeek, usada nos pareceres gerados por Inteligência Artificial.
# Sem ela o sistema funciona; apenas os relatórios de IA ficam indisponíveis.
DEEPSEEK_KEY=
