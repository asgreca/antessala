# Exemplo de vhost. Depois de apontar o DNS, emita o certificado com:
#   certbot --nginx -d seu-dominio.exemplo.br --redirect
server {
    listen 80;
    server_name seu-dominio.exemplo.br;

    root /caminho/para/antessala/frontend/dist;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript;

    location /assets/ {
        expires 30d;
    }

    # O index.html precisa ser revalidado a cada visita: ele aponta para os
    # arquivos de /assets/, que mudam de nome a cada build e são apagados no
    # deploy. Em cache, o navegador pediria arquivos que não existem mais.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # A raiz "/" resolve o index.html dentro do próprio location, sem passar
    # pelo bloco acima — por isso precisa do mesmo cabeçalho.
    location = / {
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Pareceres de IA podem levar cerca de 1 minuto.
        proxy_read_timeout 180s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
